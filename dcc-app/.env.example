# Banco de dados Postgres (Vercel Postgres, Neon, Supabase, etc.)
# Formato: postgresql://usuario:senha@host:porta/banco?sslmode=require
DATABASE_URL=""

# NextAuth
# Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL pública do seu app depois do deploy (ex: https://seuapp.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Webhook da Hotmart
# Cadastre esse mesmo valor no painel da Hotmart (Ferramentas > Webhook > Token HOTTOK)
HOTMART_HOTTOK=""

# Envio de e-mail com as credenciais de acesso (usando https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="acesso@seudominio.com"
